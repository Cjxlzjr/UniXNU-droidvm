diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -1336,6 +1336,9 @@
 # TODO: this is very incomplete
 if ['linux', 'cygwin', 'gnu', 'freebsd', 'gnu/kfreebsd', 'haiku', 'android', 'managarm'].contains(host_machine.system())
   pre_args += '-D_GNU_SOURCE'
+elif host_machine.system() == 'darwin'
+  # Generated sources can select POSIX mode before including system headers.
+  pre_args += '-D_DARWIN_C_SOURCE'
 elif host_machine.system() == 'sunos'
   pre_args += '-D__EXTENSIONS__'
 elif host_machine.system() == 'windows'
diff --git a/src/util/u_endian.h b/src/util/u_endian.h
--- a/src/util/u_endian.h
+++ b/src/util/u_endian.h
@@ -30,2 +30,2 @@
-#ifdef HAVE_ENDIAN_H
+#if defined(HAVE_ENDIAN_H) && !defined(__APPLE__)
 #include <endian.h>
diff --git a/src/freedreno/vulkan/meson.build b/src/freedreno/vulkan/meson.build
--- a/src/freedreno/vulkan/meson.build
+++ b/src/freedreno/vulkan/meson.build
@@ -150,2 +150,6 @@
   tu_link_args += ['-Wl,-undefined,dynamic_lookup']
+  if meson.is_cross_build()
+    # The guest weak-import rewriter operates on the chained fixups table.
+    tu_link_args += ['-Wl,-fixup_chains']
+  endif
 endif
